[Unit]
Description=Ψηφιακή Πύλη — Δημιουργός Custom Εφαρμογών / App Builder Wizard (FastAPI/Uvicorn)
Documentation=file:///opt/school-portal/CUSTOM-APPS-GUIDE.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/school-portal/app-builder
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/opt/school-portal/app-builder
# Κοινό πακέτο common/ (auth, classes, lessons, db, schedule) στη ρίζα της πύλης
Environment=PYTHONPATH=/opt/school-portal
ExecStart=/opt/school-portal/venv/bin/uvicorn main:app \
    --host 127.0.0.1 --port 8008 \
    --root-path /app-builder --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --workers 1 --no-access-log --log-level warning \
    --timeout-keep-alive 5

Restart=on-failure
RestartSec=5s

# --- Ελάχιστη κατανάλωση πόρων (εργαλείο καθηγητή, όχι μαζική χρήση) ---
MemoryMax=256M
MemoryHigh=192M
CPUWeight=50
Nice=5
TasksMax=64

# --- Ασφάλεια / hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
# Η εφαρμογή γράφει ΜΟΝΟ: .cookie-secret (app-builder/), νέες εφαρμογές +
# apps-manifest.json (custom-apps/) και ενσωματώσεις σε μαθήματα (mkdocs-site/docs).
# Το mkdocs rebuild γίνεται από το school-mkdocs.path/service (root) ή από το
# build-docs.sh ως www-data (data/ & /var/www/docs είναι ήδη group-writable).
ReadWritePaths=/opt/school-portal/app-builder
ReadWritePaths=/opt/school-portal/custom-apps
ReadWritePaths=/opt/school-portal/mkdocs-site
ReadWritePaths=/opt/school-portal/data
ReadWritePaths=/var/www/docs
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target