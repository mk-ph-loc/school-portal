[Unit]
Description=Ψηφιακή Πύλη — Συνεργατικό Σημειωματάριο Τάξης / Etherpad Lite (Node.js + SQLite)
Documentation=file:///opt/school-portal/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/school-portal/apps/etherpad/src
Environment=NODE_ENV=production
Environment=HOME=/opt/school-portal/apps/etherpad
Environment=ETHERPAD_PRODUCTION=1
# Απευθείας εκκίνηση του server από το src/ (όπως κάνει το "pnpm run prod"·
# τα deps έχουν εγκατασταθεί από το install.sh, δεν ξαναχτίζουμε σε κάθε boot).
# Το Etherpad εντοπίζει τη ρίζα του project από το __dirname του server.ts.
ExecStart=/usr/bin/node --require tsx/cjs node/server.ts
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120

# --- Ελάχιστη κατανάλωση πόρων (ένα εργαστήριο ≤60 ταυτόχρονοι συντάκτες) ---
MemoryMax=384M
MemoryHigh=256M
CPUWeight=50
Nice=5
TasksMax=128

# --- Ασφάλεια / hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
# Η εφαρμογή γράφει ΜΟΝΟ μέσα στον φάκελό της: var/etherpad.db (SQLite),
# var/minified* (cache JS/CSS) & var/installed_plugins.json.
ReadWritePaths=/opt/school-portal/apps/etherpad
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target