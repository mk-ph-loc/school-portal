[Unit]
Description=Ψηφιακή Πύλη — Ζωντανή Τάξη / Classroom Hub (FastAPI/Uvicorn + WebSockets)
Documentation=file:///opt/school-portal/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/school-portal/apps/classroom-hub
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/opt/school-portal/apps/classroom-hub
# Κοινό πακέτο common/ (auth, classes, lessons, db, schedule) στη ρίζα της πύλης
Environment=PYTHONPATH=/opt/school-portal
ExecStart=/opt/school-portal/venv/bin/uvicorn app:app \
    --host 127.0.0.1 --port 8014 \
    --root-path /classroom --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --workers 1 --no-access-log --log-level warning \
    --timeout-keep-alive 5 \
    --ws websockets --ws-ping-interval 20 --ws-ping-timeout 20

Restart=on-failure
RestartSec=5s

# --- Ελάχιστη κατανάλωση πόρων (ένα εργαστήριο ≤60 συνδέσεις WS) ---
MemoryMax=256M
MemoryHigh=192M
CPUWeight=50
Nice=5
TasksMax=64

# --- Ασφάλεια / hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
# Η εφαρμογή γράφει ΜΟΝΟ μέσα στον φάκελό της: data/ (classroom.db, config.json,
# rythmiseis-protypo.xlsx) & .cookie-secret. Διαβάζει (read-only) το schedule.json
# του lesson-wizard για συγχρονισμό των timers με το ωράριο.
ReadWritePaths=/opt/school-portal/apps/classroom-hub
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
