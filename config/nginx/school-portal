# ===========================================================================
# Ψηφιακή Πύλη Σχολείου & Εργαστηρίου — Nginx site (θύρα 80)
#
#   /               → Dashboard (στατικό HTML/Tailwind/Alpine)
#   /docs/          → Εκπαιδευτικό υλικό (static MkDocs στο /var/www/docs)
#   /docs/_paradeigma/teachers/ → Λύσεις Καθηγητή παλιού υλικού (HTTP Basic Auth)
#   /docs/mathimata/**/*.teacher.html → Σημειώσεις καθηγητή (auth_request → :8013)
#   /lesson-wizard/ → Lesson Wizard ημερήσιων μαθημάτων (FastAPI @127.0.0.1:8013)
#   /pandoc/        → Visual Pandoc Studio (FastAPI @127.0.0.1:8002, Basic Auth)
#   /lab/           → Διαχείριση Εργαστηρίου (placeholder· μελλοντικά :8001)
#   /crypto/        → CyberChef (static HTML/JS — 0 MB RAM)
#   /tools/         → IT-Tools (static SPA — 0 MB RAM)
#   /board/         → Ψηφιακός Πίνακας Excalidraw (πλήρες static build — 0 MB RAM)
#   /board-ws/      → Excalidraw Room Server (Node+Socket.IO @127.0.0.1:8010, LAN collab)
#   /pad/           → Συνεργατικό Σημειωματάριο Etherpad Lite (Node @127.0.0.1:8006)
#   /md-pad/        → Συνεργατικό Markdown HedgeDoc (Node+SQLite @127.0.0.1:8007)
#   /md-publish/    → Δημοσίευση HedgeDoc → MkDocs (FastAPI @127.0.0.1:8009)
#   /circuits/      → CircuitJS1 Προσομοιωτής Κυκλωμάτων (static — 0 MB RAM)
#   /blockly/       → Blockly Games (static, ελληνικά — 0 MB RAM)
#   /sql/           → SQL Playground (static, SQLite WASM — 0 MB RAM)
#   /pdf-tools/     → PDF Studio (static, pdf-lib — 0 MB RAM)
#   /apps/          → Δικές μου εφαρμογές (custom-apps/, static — 0 MB RAM)
#   /app-builder/   → Δημιουργός Custom Εφαρμογών (FastAPI @127.0.0.1:8008)
#   /share/         → FileBrowser (Go binary @127.0.0.1:8003, ~15 MB RAM)
#   /exams/         → Παράδοση Εργασιών & Διαγωνίσματα (FastAPI @127.0.0.1:8004)
#   /live-quiz/     → Ζωντανό Παιχνίδι Τάξης (FastAPI+WebSockets @127.0.0.1:8005)
#   /web-lab/       → Εργαστήριο Web HTML/CSS/JS (FastAPI+WebSockets @127.0.0.1:8011)
#   /h5p-studio/    → H5P Studio Διαδραστικών Ασκήσεων (FastAPI+SQLite @127.0.0.1:8012)
# ===========================================================================

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    # HTTPS — απαραίτητο για το Web Crypto API (secure context) που χρειάζεται
    # η ζωντανή συνεργασία & το "Export to Link" του Excalidraw (/board/).
    # Self-signed πιστοποιητικό 10ετίας (scripts/make-ssl-cert.sh)· οι browsers
    # θα δείξουν μία προειδοποίηση την πρώτη φορά ("Αποδοχή κινδύνου").
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    ssl_certificate     /etc/nginx/ssl/school-portal.crt;
    ssl_certificate_key /etc/nginx/ssl/school-portal.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:2m;
    ssl_session_timeout 1h;
    server_name _;

    # Το dashboard είναι προσβάσιμο και με HTTP και με HTTPS· τα εργαλεία που
    # απαιτούν secure context (Excalidraw collab) λειτουργούν πλήρως μόνο μέσω
    # https:// — γι' αυτό ΔΕΝ κάνουμε ολικό redirect από τη θύρα 80.

    root /opt/school-portal/dashboard;
    index index.html;

    charset utf-8;
    client_max_body_size 100M;
    client_body_timeout 120s;

    access_log /var/log/nginx/school-portal.access.log;
    error_log  /var/log/nginx/school-portal.error.log warn;

    # --- Συμπίεση (εξοικονόμηση bandwidth στο σχολικό LAN) ---
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml+rss image/svg+xml application/wasm;

    # --- Ασφάλεια: βασικές κεφαλίδες ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # -----------------------------------------------------------------
    # 1. Κεντρικό Dashboard
    # -----------------------------------------------------------------
    location / {
        try_files $uri $uri/ =404;
    }

    location /assets/ {
        alias /opt/school-portal/dashboard/assets/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # -----------------------------------------------------------------
    # 2. Εκπαιδευτικό Υλικό — static MkDocs (μηδέν RAM)
    # -----------------------------------------------------------------

    # 2α. Περιοχή Καθηγητών (παλιό υλικό) — HTTP Basic Auth (προηγείται του /docs/)
    location ^~ /docs/_paradeigma/teachers/ {
        alias /var/www/docs/_paradeigma/teachers/;
        index index.html;

        auth_basic "Περιοχή Καθηγητών — Ψηφιακή Πύλη";
        auth_basic_user_file /etc/nginx/.school-htpasswd;

        try_files $uri $uri/ =404;
    }

    # 2α-2. Σημειώσεις Καθηγητή ημερήσιων μαθημάτων — προστασία με auth_request
    #        προς το Lesson Wizard (έγκυρο HMAC cookie καθηγητή). Το περιεχόμενο
    #        ΔΕΝ υπάρχει στο HTML των μαθητών· σερβίρεται μόνο εδώ, κατόπιν ελέγχου.
    #        ΠΡΟΣΟΧΗ: πρέπει να είναι ^~ ώστε να υπερισχύει του γενικού ^~ /docs/
    #        (αλλιώς τα regex locations δεν εξετάζονται καν για αυτά τα URIs).
    location ^~ /docs/mathimata/ {
        alias /var/www/docs/mathimata/;
        index index.html;

        # Μόνο τα *.teacher.html περνούν από έλεγχο καθηγητή· τα υπόλοιπα αρχεία
        # (μαθήματα, εικόνες, pdf, διαδραστικά) μένουν ελεύθερα στους μαθητές.
        # Nested regex: χρησιμοποιούμε root (ΟΧΙ alias — δεν επιτρέπεται μαζί με
        # root)· το URI /docs/mathimata/... αντιστοιχεί στο /var/www/docs/mathimata/...
        location ~ \.teacher\.html$ {
            auth_request /_lessonwizard_check;
            root /var/www;
            try_files $uri =404;
        }

        try_files $uri $uri/ =404;
    }

    location = /_lessonwizard_check {
        internal;
        proxy_pass http://127.0.0.1:8013/api/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }

    # 2β. Pyodide — μεγάλα αρχεία WASM, μακροχρόνια cache
    location ^~ /docs/assets/pyodide/ {
        alias /var/www/docs/assets/pyodide/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;

        types {
            application/wasm wasm;
            application/javascript js mjs;
            application/json json;
            application/zip zip;
        }
        default_type application/octet-stream;
    }

    # 2γ. Υπόλοιπο εκπαιδευτικό υλικό (ελεύθερη πρόσβαση)
    location ^~ /docs/ {
        alias /var/www/docs/;
        index index.html;
        try_files $uri $uri/ =404;
    }
    # -----------------------------------------------------------------
    # 3. Visual Pandoc Studio — reverse proxy + Basic Auth
    # -----------------------------------------------------------------
    location ^~ /pandoc/ {
        auth_basic "Visual Pandoc Studio — Πρόσβαση Καθηγητών";
        auth_basic_user_file /etc/nginx/.school-htpasswd;

        proxy_pass http://127.0.0.1:8002/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /pandoc;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";

        # Οι μετατροπές PDF/DOCX μπορεί να διαρκέσουν
        proxy_connect_timeout 30s;
        proxy_send_timeout    180s;
        proxy_read_timeout    180s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # -----------------------------------------------------------------
    # 4. Διαχείριση Εργαστηρίου
    #    ΤΩΡΑ: στατική σελίδα «Υπό Κατασκευή» (Προβολή για μαθητές).
    #    ΜΕΛΛΟΝΤΙΚΑ: αντικατάσταση με proxy_pass στο 127.0.0.1:8001
    #    όταν υλοποιηθεί το school-lab.service (FastAPI + SQLite).
    # -----------------------------------------------------------------
    location ^~ /lab/ {
        alias /opt/school-portal/dashboard/lab/;
        index index.html;
        try_files $uri $uri/ =404;

        # --- ΜΕΛΛΟΝΤΙΚΗ ΡΥΘΜΙΣΗ (σχολιασμένη) ---
        # proxy_pass http://127.0.0.1:8001/;
        # proxy_http_version 1.1;
        # proxy_set_header Host $host;
        # proxy_set_header X-Real-IP $remote_addr;
        # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # proxy_set_header X-Forwarded-Proto $scheme;
        # proxy_set_header X-Forwarded-Prefix /lab;
    }

    # -----------------------------------------------------------------
    # 5. Εργαλεία Εργαστηρίου — static (μηδέν RAM στον server)
    #    Όλα εκτελούνται 100% στον browser των μαθητών/καθηγητών.
    # -----------------------------------------------------------------

    # 5α. CyberChef — κρυπτογραφία, κωδικοποιήσεις, hashes (gchq/CyberChef)
    location ^~ /crypto/ {
        alias /var/www/school-tools/cyberchef/;
        index index.html;
        try_files $uri $uri/ =404;

        expires 7d;
        add_header Cache-Control "public";
    }

    # 5β. IT-Tools — σουίτα εργαλείων IT (CorentinTh/it-tools, SPA base=/tools/)
    location ^~ /tools/ {
        alias /var/www/school-tools/it-tools/;
        index index.html;
        # SPA fallback: τα routes του Vue router (π.χ. /tools/uuid-generator)
        # επιστρέφουν το index.html αντί για 404.
        try_files $uri $uri/ /tools/index.html;

        expires 7d;
        add_header Cache-Control "public";
    }
    # Ο service worker του IT-Tools δεν πρέπει να cache-άρεται επιθετικά
    location = /tools/sw.js {
        alias /var/www/school-tools/it-tools/sw.js;
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/tools/";
    }

    # 5γ. Ψηφιακός Πίνακας Excalidraw — πλήρες static build του excalidraw-app
    #     (βιβλιοθήκες σχημάτων, εξαγωγή PNG/SVG/JSON, dark/light, ελληνικά).
    #     Όλα τοπικά: assets, chunks, locales & fonts (scripts/fetch-excalidraw.sh).
    location = /board {
        return 301 /board/;
    }
    location ^~ /board/ {
        alias /var/www/school-tools/board/;
        index index.html;
        try_files $uri $uri/ =404;

        # Το index.html αλλάζει σε κάθε ενημέρωση → όχι επιθετικό caching
        add_header Cache-Control "no-cache";
    }
    # Τα hashed Vite bundles/fonts αλλάζουν όνομα σε κάθε έκδοση → immutable
    location ^~ /board/assets/ {
        alias /var/www/school-tools/board/assets/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Excalidraw Room Server — self-hosted ζωντανή συνεργασία πίνακα (LAN).
    # Το frontend bundle έχει patchαριστεί (scripts/fetch-excalidraw.sh) ώστε
    # να συνδέεται εδώ αντί για το oss-collab.excalidraw.com.
    # Όλα τα δεδομένα είναι end-to-end encrypted (AES-GCM στον browser).
    location = /board-ws {
        return 301 /board-ws/;
    }
    location ^~ /board-ws/ {
        proxy_pass http://127.0.0.1:8010/;
        proxy_http_version 1.1;

        # --- Υποστήριξη WebSockets (Socket.IO — ζωντανά strokes/cursors) ---
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Οι συνδέσεις WS μένουν ανοιχτές καθ' όλη τη διάρκεια του μαθήματος
        proxy_connect_timeout 30s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
        proxy_buffering off;
    }
    location ^~ /board/fonts/ {
        alias /var/www/school-tools/board/fonts/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 5δ. CircuitJS1 — προσομοιωτής ηλεκτρονικών κυκλωμάτων (pfalstad/circuitjs1)
    location ^~ /circuits/ {
        alias /var/www/school-tools/circuits/;
        index index.html;
        try_files $uri $uri/ =404;

        expires 7d;
        add_header Cache-Control "public";
    }
    # Τα hashed bundles του CircuitJS αλλάζουν όνομα σε κάθε έκδοση → immutable
    location ^~ /circuits/circuitjs116/ {
        alias /var/www/school-tools/circuits/circuitjs116/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 5ε. Blockly Games — εκμάθηση προγραμματισμού με μπλοκ (static, ελληνικά)
    #     ΣΗΜΕΙΩΣΗ: ΟΧΙ ^~ εδώ — τα extensionless URLs των παιχνιδιών πρέπει
    #     να πιάνονται από τα regex locations που ακολουθούν (προτεραιότητα).
    location /blockly/ {
        alias /var/www/school-tools/blockly/;
        index index.html;
        try_files $uri $uri/ =404;

        expires 7d;
        add_header Cache-Control "public";
    }
    # Τα παιχνίδια είναι αρχεία .html (raw-HTML mode του Blockly Games)· τα
    # extensionless URLs (π.χ. /blockly/maze?lang=el ή /blockly/maze/?lang=el)
    # πρέπει να καταλήγουν στο αντίστοιχο .html, αλλιώς ο φάκελος assets
    # επιστρέφει 403 (directory index forbidden). Το query string
    # (?lang=el&level=N) διατηρείται αυτόματα από το rewrite.
    location ~ ^/blockly/(puzzle|maze|bird|turtle|movie|music|pond-tutor|pond-duck)/?$ {
        rewrite ^/blockly/([-\w]+)/?$ /blockly/$1.html permanent;
    }
    location = /blockly/index {
        return 301 /blockly/index.html$is_args$args;
    }
    # Ο boot.js επιλέγει γλώσσα & φορτώνει τα bundles → όχι επιθετικό caching
    location = /blockly/common/boot.js {
        alias /var/www/school-tools/blockly/common/boot.js;
        add_header Cache-Control "no-cache";
    }

    # 5στ. SQL Playground — εργαστήριο βάσεων δεδομένων (sql.js / SQLite WASM)
    location ^~ /sql/ {
        alias /var/www/school-tools/sql/;
        index index.html;
        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache";
    }
    location ^~ /sql/vendor/ {
        alias /var/www/school-tools/sql/vendor/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;

        types {
            application/wasm wasm;
            application/javascript js;
        }
        default_type application/octet-stream;
    }

    # 5ζ. PDF Studio — συγχώνευση/split/υδατογράφημα PDF (pdf-lib, 100% τοπικά)
    location ^~ /pdf-tools/ {
        alias /var/www/school-tools/pdf-tools/;
        index index.html;
        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache";
    }
    location ^~ /pdf-tools/vendor/ {
        alias /var/www/school-tools/pdf-tools/vendor/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 5η. Δικές μου Εφαρμογές & Προσομοιώσεις — custom-apps/ (static, 0 MB RAM)
    #     ΓΕΝΙΚΟ location: κάθε νέος υποφάκελος του custom-apps/ (π.χ. my-app/)
    #     σερβίρεται ΑΜΕΣΑ στο /apps/my-app/ χωρίς καμία αλλαγή/reload εδώ.
    #     Η λίστα καρτών του Dashboard παράγεται από το app.json κάθε εφαρμογής
    #     με το scripts/build-apps-manifest.py → apps-manifest.json.
    #     Οδηγός: CUSTOM-APPS-GUIDE.md
    location = /apps {
        return 301 /apps/;
    }
    location /apps/ {
        alias /opt/school-portal/custom-apps/;
        index index.html;
        try_files $uri $uri/ =404;

        # Όχι επιθετικό caching: οι εκπαιδευτικές εφαρμογές αλλάζουν συχνά
        add_header Cache-Control "no-cache";
    }
    # Το πρότυπο (_template) δεν είναι εφαρμογή — δεν σερβίρεται
    location ^~ /apps/_template/ {
        return 404;
    }

    # -----------------------------------------------------------------
    # 5θ. Δημιουργός Custom Εφαρμογών — App Builder Wizard (@127.0.0.1:8008)
    #     FastAPI· περιβάλλον καθηγητή με κωδικό teacher2026 (HMAC cookie,
    #     όπως στο /exams/teacher). Δημιουργεί εφαρμογές στο custom-apps/,
    #     ενημερώνει το manifest και ενσωματώνει iframe σε μαθήματα MkDocs.
    # -----------------------------------------------------------------
    location = /app-builder {
        return 301 /app-builder/;
    }

    location ^~ /app-builder/ {
        client_max_body_size 50M;

        proxy_pass http://127.0.0.1:8008/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Ανεβάσματα ZIP έως 50 MB σε αργό σχολικό LAN
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_request_buffering off;
    }

    # -----------------------------------------------------------------
    # 6. FileBrowser — κοινόχρηστα αρχεία (reverse proxy @127.0.0.1:8003)
    #    Single Go binary (~15 MB RAM) με δική του login (admin).
    # -----------------------------------------------------------------
    location ^~ /share/ {
        client_max_body_size 200M;

        # Το filebrowser τρέχει με --baseURL /share, οπότε περνάμε
        # το πλήρες URI χωρίς αφαίρεση του prefix.
        proxy_pass http://127.0.0.1:8003;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";

        # Μεγάλα uploads/downloads σχολικών αρχείων
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_request_buffering off;
    }

    # -----------------------------------------------------------------
    # 6β. Παράδοση Εργασιών & Ψηφιακά Διαγωνίσματα (@127.0.0.1:8004)
    #     FastAPI + SQLite· το /exams/ είναι ελεύθερο για μαθητές, ενώ το
    #     περιβάλλον καθηγητή (/exams/teacher) προστατεύεται από την ίδια
    #     την εφαρμογή με κωδικό teacher2026 (HMAC-signed cookie).
    # -----------------------------------------------------------------
    location = /exams {
        return 301 /exams/;
    }

    location ^~ /exams/ {
        client_max_body_size 50M;

        proxy_pass http://127.0.0.1:8004/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Ανεβάσματα εργασιών έως 50 MB σε αργό σχολικό LAN
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_request_buffering off;
    }

    # -----------------------------------------------------------------
    # 6γ. Ζωντανό Παιχνίδι Τάξης — Live Quiz (@127.0.0.1:8005, WebSockets)
    #     FastAPI + SQLite· το /live-quiz/ είναι ελεύθερο για μαθητές
    #     (είσοδος με 4-ψήφιο PIN), ενώ η οθόνη καθηγητή/προτζέκτορα
    #     (/live-quiz/teacher) προστατεύεται από την εφαρμογή με κωδικό
    #     teacher2026 (HMAC-signed cookie).
    # -----------------------------------------------------------------
    location = /live-quiz {
        return 301 /live-quiz/;
    }

    location ^~ /live-quiz/ {
        proxy_pass http://127.0.0.1:8005/;
        proxy_http_version 1.1;

        # --- Υποστήριξη WebSockets (ζωντανές ερωτήσεις/απαντήσεις) ---
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Οι συνδέσεις WS μένουν ανοιχτές καθ' όλη τη διάρκεια του μαθήματος
        proxy_connect_timeout 30s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------
    # 6γ2. Εργαστήριο Web (HTML / CSS / JS) — @127.0.0.1:8011, WebSockets
    #      FastAPI + SQLite (systemd: school-weblab.service). Οι μαθητές
    #      δουλεύουν ατομικά (localStorage) ή σε δωμάτια ομάδας με 4-ψήφιο
    #      PIN· ο καθηγητής (κωδικός teacher2026, HMAC cookie) κάνει
    #      broadcast/κλείδωμα και δημοσιεύει στα /apps/ (custom-apps).
    #      ΣΗΜΕΙΩΣΗ: η 8010 ανήκει ήδη στο excalidraw-room (/board-ws/).
    # -----------------------------------------------------------------
    location = /web-lab {
        return 301 /web-lab/;
    }

    location ^~ /web-lab/ {
        proxy_pass http://127.0.0.1:8011/;
        proxy_http_version 1.1;

        # --- Υποστήριξη WebSockets (ζωντανός συγχρονισμός κώδικα τάξης) ---
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Οι συνδέσεις WS μένουν ανοιχτές καθ' όλη τη διάρκεια του μαθήματος
        proxy_connect_timeout 30s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------
    # 6γ3. H5P Studio — Διαδραστικές Ασκήσεις (@127.0.0.1:8012)
    #      FastAPI + SQLite (systemd: school-h5p.service). Offline player
    #      h5p-standalone + τοπικές βιβλιοθήκες H5P· ο καθηγητής (κωδικός
    #      teacher2026, HMAC cookie) δημιουργεί/επεξεργάζεται με Visual
    #      Editor & AI Wizard, οι μαθητές παίζουν ελεύθερα στο /play/<id>/.
    #      ΣΗΜΕΙΩΣΗ: η 8011 ανήκει ήδη στο Web Lab (/web-lab/).
    # -----------------------------------------------------------------
    location = /h5p-studio {
        return 301 /h5p-studio/;
    }

    location ^~ /h5p-studio/ {
        proxy_pass http://127.0.0.1:8012/;
        proxy_http_version 1.1;

        # Μεγάλα αρχεία: import/export .h5p & ανέβασμα βίντεο (.mp4)
        client_max_body_size 100M;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /h5p-studio;

        # Το AI generation μπορεί να πάρει ~1-2 λεπτά (Qwen API)
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------
    # 6δ. Συνεργατικό Σημειωματάριο Τάξης — Etherpad Lite (@127.0.0.1:8006)
    #     Node.js + SQLite (systemd: school-etherpad.service, ~60-220 MB RAM).
    #     Οι μαθητές μπαίνουν ελεύθερα στο /pad/ και γράφουν ταυτόχρονα·
    #     το /pad/admin προστατεύεται με τον κωδικό καθηγητή (Basic Auth).
    # -----------------------------------------------------------------
    location = /pad {
        return 301 /pad/;
    }

    # Πίνακας διαχειριστή Etherpad — μόνο για καθηγητές
    location ^~ /pad/admin {
        auth_basic "Περιοχή Καθηγητών — Ψηφιακή Πύλη";
        auth_basic_user_file /etc/nginx/.school-htpasswd;

        proxy_pass http://127.0.0.1:8006/admin;
        proxy_http_version 1.1;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_buffering off;
    }

    location ^~ /pad/ {
        # Το trailing slash κόβει το /pad/ prefix → το Etherpad βλέπει /, /p/…
        # (λειτουργεί χωρίς rootPath ρύθμιση· όλα τα links είναι σχετικά)
        proxy_pass http://127.0.0.1:8006/;
        proxy_http_version 1.1;

        # --- Υποστήριξη WebSockets (socket.io — ζωντανή συνεργασία τάξης) ---
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Διόρθωση απόλυτων paths που επιστρέφει το Etherpad (redirects &
        # φόρμα reconnect) ώστε να μένουν κάτω από το /pad/ της πύλης.
        proxy_redirect / /pad/;
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter 'action="/ep/pad/reconnect"' 'action="/pad/ep/pad/reconnect"';
        sub_filter 'href="/javascript"' 'href="/pad/javascript"';
        sub_filter 'href="/manifest.json"' 'href="/pad/manifest.json"';

        # Οι συνδέσεις WS μένουν ανοιχτές καθ' όλη τη διάρκεια του μαθήματος
        proxy_connect_timeout 30s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------
    # 6ε. Συνεργατικό Markdown — HedgeDoc (@127.0.0.1:8007)
    #     Node.js + SQLite (systemd: school-hedgedoc.service). Το urlPath
    #     "md-pad" στο config.json επηρεάζει ΜΟΝΟ τα παραγόμενα URLs· οι
    #     routers ακούν στο /, άρα το trailing slash του proxy_pass κόβει
    #     το /md-pad/ prefix (όπως στο /pad/ του Etherpad).
    #     Οι μαθητές γράφουν ταυτόχρονα Markdown (socket.io WebSockets).
    # -----------------------------------------------------------------
    location = /md-pad {
        return 301 /md-pad/;
    }

    location ^~ /md-pad/ {
        proxy_pass http://127.0.0.1:8007/;
        proxy_http_version 1.1;

        # --- Υποστήριξη WebSockets (socket.io — ζωντανή συνεργασία τάξης) ---
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Οι συνδέσεις WS μένουν ανοιχτές καθ' όλη τη διάρκεια του μαθήματος
        proxy_connect_timeout 30s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------
    # 6στ. Δημοσίευση HedgeDoc → MkDocs (@127.0.0.1:8009)
    #      FastAPI micro-bridge (systemd: school-mdbridge.service) με δική
    #      του πύλη κωδικού καθηγητή (HMAC cookie, όπως το /app-builder/).
    #      Επιλογή σημείωσης από τη βάση HedgeDoc → append σε υπάρχον μάθημα
    #      ή νέο μάθημα + nav, με αυτόματο .bak backup & καθαρισμό σύνταξης.
    # -----------------------------------------------------------------
    location = /md-publish {
        return 301 /md-publish/;
    }

    location ^~ /md-publish/ {
        proxy_pass http://127.0.0.1:8009/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /md-publish;

        proxy_connect_timeout 30s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------
    # 6ζ. Lesson Wizard — Ημερήσια Μαθήματα (@127.0.0.1:8013)
    #      FastAPI (systemd: school-lessonwizard.service) με δική του πύλη
    #      κωδικού καθηγητή (HMAC cookie, όπως το /app-builder/). Visual
    #      επεξεργαστής διδακτικών φάσεων, upload υλικού φακέλου μαθήματος,
    #      ωράριο από Excel & ενεργό μάθημα. Παρέχει και το /api/check για
    #      την προστασία των *.teacher.html (auth_request παραπάνω).
    # -----------------------------------------------------------------
    location = /lesson-wizard {
        return 301 /lesson-wizard/;
    }

    location ^~ /lesson-wizard/ {
        proxy_pass http://127.0.0.1:8013/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /lesson-wizard;

        proxy_connect_timeout 30s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        proxy_buffering off;
    }

    # -----------------------------------------------------------------
    # 6ιστ. Ζωντανή Τάξη — Classroom Hub (@127.0.0.1:8014, WebSockets)
    #       Κεντρικό παράθυρο με μόνιμο μενού ανά ρόλο (guest/μαθητής/
    #       καθηγητής), όλες οι εφαρμογές σε iframe, dock/float εργαλειοθήκες,
    #       παρουσία σε πραγματικό χρόνο, ανακοινώσεις/βραβεία/polls/quiz,
    #       timers συγχρονισμένοι με το ωράριο ±offset, ενιαίο Excel ρυθμίσεων.
    #       Ο καθηγητής προστατεύεται με κωδικό teacher2026 (HMAC cookie).
    # -----------------------------------------------------------------
    location = /classroom {
        return 301 /classroom/;
    }

    location ^~ /classroom/ {
        proxy_pass http://127.0.0.1:8014/;
        proxy_http_version 1.1;

        # --- Υποστήριξη WebSockets (παρουσία/heartbeat & εντολές τάξης) ---
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Οι συνδέσεις WS μένουν ανοιχτές καθ' όλη τη διάρκεια του μαθήματος
        proxy_connect_timeout 30s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
        proxy_buffering off;

        # Ανέβασμα ενιαίου Excel ρυθμίσεων
        client_max_body_size 10m;
    }

    # -----------------------------------------------------------------
    # 7. Διάφορα
    # -----------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "school-portal OK\n";
    }

    location = /favicon.ico {
        alias /opt/school-portal/dashboard/assets/favicon.svg;
        access_log off;
        log_not_found off;
    }

    # Απόκρυψη κρυφών αρχείων (.git, .env.keys κ.λπ.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}