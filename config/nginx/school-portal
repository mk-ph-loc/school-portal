# ===========================================================================
# Ψηφιακή Πύλη Σχολείου & Εργαστηρίου — Nginx site (θύρα 80)
#
#   /               → Dashboard (στατικό HTML/Tailwind/Alpine)
#   /docs/          → Εκπαιδευτικό υλικό (static MkDocs στο /var/www/docs)
#   /docs/teachers/ → Λύσεις Καθηγητή (HTTP Basic Auth)
#   /pandoc/        → Visual Pandoc Studio (FastAPI @127.0.0.1:8002, Basic Auth)
#   /lab/           → Διαχείριση Εργαστηρίου (placeholder· μελλοντικά :8001)
#   /crypto/        → CyberChef (static HTML/JS — 0 MB RAM)
#   /tools/         → IT-Tools (static SPA — 0 MB RAM)
#   /board/         → Ψηφιακός Πίνακας Τάξης (static canvas — 0 MB RAM)
#   /circuits/      → CircuitJS1 Προσομοιωτής Κυκλωμάτων (static — 0 MB RAM)
#   /blockly/       → Blockly Games (static, ελληνικά — 0 MB RAM)
#   /sql/           → SQL Playground (static, SQLite WASM — 0 MB RAM)
#   /pdf-tools/     → PDF Studio (static, pdf-lib — 0 MB RAM)
#   /share/         → FileBrowser (Go binary @127.0.0.1:8003, ~15 MB RAM)
#   /exams/         → Παράδοση Εργασιών & Διαγωνίσματα (FastAPI @127.0.0.1:8004)
# ===========================================================================

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /opt/school-portal/dashboard;
    index index.html;

    charset utf-8;
    client_max_body_size 100M;
    client_body_timeout 120s;

    access_log /var/log/nginx/school-portal.access.log;
    error_log  /var/log/nginx/school-portal.error.log warn;

    # --- Συμπίεση (εξοικονόμηση bandwidth στο σχολικό LAN) ---
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml+rss image/svg+xml application/wasm;

    # --- Ασφάλεια: βασικές κεφαλίδες ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # -----------------------------------------------------------------
    # 1. Κεντρικό Dashboard
    # -----------------------------------------------------------------
    location / {
        try_files $uri $uri/ =404;
    }

    location /assets/ {
        alias /opt/school-portal/dashboard/assets/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # -----------------------------------------------------------------
    # 2. Εκπαιδευτικό Υλικό — static MkDocs (μηδέν RAM)
    # -----------------------------------------------------------------

    # 2α. Περιοχή Καθηγητών — HTTP Basic Auth (προηγείται του /docs/)
    location ^~ /docs/teachers/ {
        alias /var/www/docs/teachers/;
        index index.html;

        auth_basic "Περιοχή Καθηγητών — Ψηφιακή Πύλη";
        auth_basic_user_file /etc/nginx/.school-htpasswd;

        try_files $uri $uri/ =404;
    }

    # 2β. Pyodide — μεγάλα αρχεία WASM, μακροχρόνια cache
    location ^~ /docs/assets/pyodide/ {
        alias /var/www/docs/assets/pyodide/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;

        types {
            application/wasm wasm;
            application/javascript js mjs;
            application/json json;
            application/zip zip;
        }
        default_type application/octet-stream;
    }

    # 2γ. Υπόλοιπο εκπαιδευτικό υλικό (ελεύθερη πρόσβαση)
    location ^~ /docs/ {
        alias /var/www/docs/;
        index index.html;
        try_files $uri $uri/ =404;
    }
    # -----------------------------------------------------------------
    # 3. Visual Pandoc Studio — reverse proxy + Basic Auth
    # -----------------------------------------------------------------
    location ^~ /pandoc/ {
        auth_basic "Visual Pandoc Studio — Πρόσβαση Καθηγητών";
        auth_basic_user_file /etc/nginx/.school-htpasswd;

        proxy_pass http://127.0.0.1:8002/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /pandoc;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";

        # Οι μετατροπές PDF/DOCX μπορεί να διαρκέσουν
        proxy_connect_timeout 30s;
        proxy_send_timeout    180s;
        proxy_read_timeout    180s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # -----------------------------------------------------------------
    # 4. Διαχείριση Εργαστηρίου
    #    ΤΩΡΑ: στατική σελίδα «Υπό Κατασκευή» (Προβολή για μαθητές).
    #    ΜΕΛΛΟΝΤΙΚΑ: αντικατάσταση με proxy_pass στο 127.0.0.1:8001
    #    όταν υλοποιηθεί το school-lab.service (FastAPI + SQLite).
    # -----------------------------------------------------------------
    location ^~ /lab/ {
        alias /opt/school-portal/dashboard/lab/;
        index index.html;
        try_files $uri $uri/ =404;

        # --- ΜΕΛΛΟΝΤΙΚΗ ΡΥΘΜΙΣΗ (σχολιασμένη) ---
        # proxy_pass http://127.0.0.1:8001/;
        # proxy_http_version 1.1;
        # proxy_set_header Host $host;
        # proxy_set_header X-Real-IP $remote_addr;
        # proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # proxy_set_header X-Forwarded-Proto $scheme;
        # proxy_set_header X-Forwarded-Prefix /lab;
    }

    # -----------------------------------------------------------------
    # 5. Εργαλεία Εργαστηρίου — static (μηδέν RAM στον server)
    #    Όλα εκτελούνται 100% στον browser των μαθητών/καθηγητών.
    # -----------------------------------------------------------------

    # 5α. CyberChef — κρυπτογραφία, κωδικοποιήσεις, hashes (gchq/CyberChef)
    location ^~ /crypto/ {
        alias /var/www/school-tools/cyberchef/;
        index index.html;
        try_files $uri $uri/ =404;

        expires 7d;
        add_header Cache-Control "public";
    }

    # 5β. IT-Tools — σουίτα εργαλείων IT (CorentinTh/it-tools, SPA base=/tools/)
    location ^~ /tools/ {
        alias /var/www/school-tools/it-tools/;
        index index.html;
        # SPA fallback: τα routes του Vue router (π.χ. /tools/uuid-generator)
        # επιστρέφουν το index.html αντί για 404.
        try_files $uri $uri/ /tools/index.html;

        expires 7d;
        add_header Cache-Control "public";
    }
    # Ο service worker του IT-Tools δεν πρέπει να cache-άρεται επιθετικά
    location = /tools/sw.js {
        alias /var/www/school-tools/it-tools/sw.js;
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/tools/";
    }

    # 5γ. Ψηφιακός Πίνακας Τάξης — canvas whiteboard (autosave στο localStorage)
    location ^~ /board/ {
        alias /var/www/school-tools/board/;
        index index.html;
        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache";
    }

    # 5δ. CircuitJS1 — προσομοιωτής ηλεκτρονικών κυκλωμάτων (pfalstad/circuitjs1)
    location ^~ /circuits/ {
        alias /var/www/school-tools/circuits/;
        index index.html;
        try_files $uri $uri/ =404;

        expires 7d;
        add_header Cache-Control "public";
    }
    # Τα hashed bundles του CircuitJS αλλάζουν όνομα σε κάθε έκδοση → immutable
    location ^~ /circuits/circuitjs116/ {
        alias /var/www/school-tools/circuits/circuitjs116/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 5ε. Blockly Games — εκμάθηση προγραμματισμού με μπλοκ (Google, offline pack)
    location ^~ /blockly/ {
        alias /var/www/school-tools/blockly/;
        index index.html;
        try_files $uri $uri/ =404;

        expires 7d;
        add_header Cache-Control "public";
    }
    # Ο boot.js επιλέγει γλώσσα & φορτώνει τα bundles → όχι επιθετικό caching
    location = /blockly/common/boot.js {
        alias /var/www/school-tools/blockly/common/boot.js;
        add_header Cache-Control "no-cache";
    }

    # 5στ. SQL Playground — εργαστήριο βάσεων δεδομένων (sql.js / SQLite WASM)
    location ^~ /sql/ {
        alias /var/www/school-tools/sql/;
        index index.html;
        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache";
    }
    location ^~ /sql/vendor/ {
        alias /var/www/school-tools/sql/vendor/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;

        types {
            application/wasm wasm;
            application/javascript js;
        }
        default_type application/octet-stream;
    }

    # 5ζ. PDF Studio — συγχώνευση/split/υδατογράφημα PDF (pdf-lib, 100% τοπικά)
    location ^~ /pdf-tools/ {
        alias /var/www/school-tools/pdf-tools/;
        index index.html;
        try_files $uri $uri/ =404;

        add_header Cache-Control "no-cache";
    }
    location ^~ /pdf-tools/vendor/ {
        alias /var/www/school-tools/pdf-tools/vendor/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # -----------------------------------------------------------------
    # 6. FileBrowser — κοινόχρηστα αρχεία (reverse proxy @127.0.0.1:8003)
    #    Single Go binary (~15 MB RAM) με δική του login (admin).
    # -----------------------------------------------------------------
    location ^~ /share/ {
        client_max_body_size 200M;

        # Το filebrowser τρέχει με --baseURL /share, οπότε περνάμε
        # το πλήρες URI χωρίς αφαίρεση του prefix.
        proxy_pass http://127.0.0.1:8003;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "";

        # Μεγάλα uploads/downloads σχολικών αρχείων
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_request_buffering off;
    }

    # -----------------------------------------------------------------
    # 6β. Παράδοση Εργασιών & Ψηφιακά Διαγωνίσματα (@127.0.0.1:8004)
    #     FastAPI + SQLite· το /exams/ είναι ελεύθερο για μαθητές, ενώ το
    #     περιβάλλον καθηγητή (/exams/teacher) προστατεύεται από την ίδια
    #     την εφαρμογή με κωδικό teacher2026 (HMAC-signed cookie).
    # -----------------------------------------------------------------
    location = /exams {
        return 301 /exams/;
    }

    location ^~ /exams/ {
        client_max_body_size 50M;

        proxy_pass http://127.0.0.1:8004/;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Ανεβάσματα εργασιών έως 50 MB σε αργό σχολικό LAN
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_request_buffering off;
    }

    # -----------------------------------------------------------------
    # 7. Διάφορα
    # -----------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "school-portal OK\n";
    }

    location = /favicon.ico {
        alias /opt/school-portal/dashboard/assets/favicon.svg;
        access_log off;
        log_not_found off;
    }

    # Απόκρυψη κρυφών αρχείων (.git, .env.keys κ.λπ.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}