# ============================================================
# Ψηφιακή Πύλη Σχολείου & Εργαστηρίου — .gitignore
# ============================================================

# --- ΜΥΣΤΙΚΑ: ποτέ στο repository ---
.env.keys
.env
*.pem
*.key
.htpasswd
.school-htpasswd

# --- Python virtual environment ---
venv/
env/
.venv/

# --- Python artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- MkDocs build output ---
mkdocs-site/site/
site/

# --- Pyodide (μεγάλα δυαδικά, κατεβαίνουν από το install.sh) ---
mkdocs-site/docs/assets/pyodide/

# --- Frontend vendor assets (κατεβαίνουν από το install.sh) ---
dashboard/assets/tailwind.min.js
dashboard/assets/alpine.min.js

# --- Δεδομένα εφαρμογών / ανεβάσματα ---
shared-files/
data/filebrowser/
pandoc-app/data/uploads/
pandoc-app/data/templates/*.docx
exams-app/submissions/
exams-app/.cookie-secret
live-quiz-app/.cookie-secret
app-builder/.cookie-secret
web-lab/.cookie-secret
lab-app/*.db
lab-app/*.sqlite
lab-app/*.sqlite3
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/build/
data/*.lock

# --- Logs & προσωρινά ---
*.log
logs/
tmp/
.tmp/
*.tmp
*.swp
*~

# --- Node.js εφαρμογές (κατεβαίνουν & χτίζονται από το install.sh — όχι στο git) ---
apps/etherpad/
apps/excalidraw-room/
apps/hedgedoc/
# Τα ελληνικά πρότυπα & το config template συντηρούνται στο config/hedgedoc/

# --- Γέφυρα MD-Publish: μυστικά & backups εκτός git (ο κώδικας app.py μένει) ---
apps/hedgedoc-bridge/.cookie-secret
apps/hedgedoc-bridge/backups/
*.bak

# --- H5P Studio: μυστικά, προσωρινά exports & backups εκτός git ---
# (Ο κώδικας, τα templates, ο offline player static/h5p-player/, οι τοπικές
#  βιβλιοθήκες h5p-libraries/ ΚΑΙ η βιβλιοθήκη δραστηριοτήτων library/<id>/
#  ΜΕΝΟΥΝ στο git — 100% offline αναπαραγωγή & versioned εκπαιδευτικό υλικό.)
h5p-studio/.cookie-secret
h5p-studio/backups/
h5p-studio/.export-*.h5p
h5p-studio/library/preview-tmp/

# --- Λειτουργικό σύστημα ---
.DS_Store
Thumbs.db